{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywidgetinstruments.github.io/anywidget-instruments-industrial/schema/radar.schema.json",
  "title": "RadarChart",
  "description": "Multi-axis (spider) chart (SPEC-004).",
  "type": "object",
  "x-awi-class": "RadarChart",
  "allOf": [
    {
      "$ref": "series.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "radar",
      "default": "radar",
      "x-awi-writer": "host"
    },
    "value": {
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "CSS color; empty: the trace palette."
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json#/$defs/float"
            },
            "description": "One value per axis."
          }
        }
      },
      "description": "Data sets {name, color, values}."
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Axis names; empty: axes numbered from the longest data set.",
      "default": [],
      "x-awi-writer": "host"
    },
    "ranges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "description": "[min, max] per axis, max > min; an axis without a valid range goes from 0 to the largest value of the data sets.",
      "default": [],
      "x-awi-writer": "host"
    },
    "fill": {
      "type": "boolean",
      "description": "Fill the data set polygons.",
      "default": true,
      "x-awi-writer": "host"
    }
  }
}
