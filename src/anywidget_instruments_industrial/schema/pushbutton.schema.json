{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywidgetinstruments.github.io/anywidget-instruments-industrial/schema/pushbutton.schema.json",
  "title": "PushButton",
  "description": "Push button with a caption, optionally illuminated (BOOL-006, BOOL-015).",
  "type": "object",
  "x-awi-class": "PushButton",
  "allOf": [
    {
      "$ref": "boolean.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "pushbutton",
      "default": "pushbutton",
      "x-awi-writer": "host"
    },
    "color": {
      "enum": [
        "grey",
        "green",
        "red",
        "black",
        "yellow",
        "blue",
        "white"
      ],
      "description": "Cap color (IEC 60073: green to start, red to stop...).",
      "default": "grey",
      "x-awi-writer": "host"
    },
    "lamp": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Built-in lamp: true lit, false unlit, null no lamp (BOOL-015). Feedback set by the host, independent of value.",
      "default": null,
      "x-awi-writer": "host"
    },
    "lamp_blink": {
      "type": "boolean",
      "description": "Flash the lamp.",
      "default": false,
      "x-awi-writer": "host"
    },
    "lamp_color": {
      "enum": [
        "green",
        "red",
        "amber",
        "blue",
        "white"
      ],
      "description": "Lamp color.",
      "default": "green",
      "x-awi-writer": "host"
    },
    "mechanical_action": {
      "default": "latch_when_released"
    },
    "shape": {
      "enum": [
        "rect",
        "round"
      ],
      "description": "rect (panel button) or round (operator); the Python class uses a 90 x 90 size for round.",
      "default": "rect",
      "x-awi-writer": "host"
    },
    "size": {
      "default": [
        110,
        44
      ]
    },
    "text": {
      "type": "string",
      "description": "Caption (plain text, SEC-002).",
      "default": "OK",
      "x-awi-writer": "host"
    }
  }
}
