{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywidgetinstruments.github.io/anywidget-instruments-industrial/schema/thermometer.schema.json",
  "title": "Thermometer",
  "description": "Vertical indicator with bulb and fluid column (NUM-107).",
  "type": "object",
  "x-awi-class": "Thermometer",
  "allOf": [
    {
      "$ref": "numeric.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "thermometer",
      "default": "thermometer",
      "x-awi-writer": "host"
    },
    "fill_color": {
      "type": "string",
      "description": "CSS color of the fluid column; empty: the theme color. Unsafe colors are ignored (SEC-002).",
      "default": "",
      "x-awi-writer": "host"
    },
    "max": {
      "default": 120.0
    },
    "min": {
      "default": -20.0
    },
    "mode": {
      "default": "indicator"
    },
    "size": {
      "default": [
        100,
        220
      ]
    },
    "ticks": {
      "default": 7
    },
    "unit": {
      "default": "°C"
    }
  }
}
