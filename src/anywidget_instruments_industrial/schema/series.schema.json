{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywidgetinstruments.github.io/anywidget-instruments-industrial/schema/series.schema.json",
  "title": "SeriesWidget",
  "description": "Widgets drawing named data sets as JSON (PolarPlot, SmithChart, RadarChart).",
  "type": "object",
  "x-awi-abstract": true,
  "x-awi-class": "_SeriesWidget",
  "allOf": [
    {
      "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json"
    }
  ],
  "properties": {
    "mode": {
      "default": "indicator"
    },
    "size": {
      "default": [
        260,
        260
      ]
    },
    "value": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Data sets, drawn in order; the fields depend on the widget. A data set with the name of an existing one replaces it (Python: plot(..., replace=True)).",
      "default": [],
      "x-awi-writer": "host"
    },
    "show_legend": {
      "type": "boolean",
      "default": true,
      "x-awi-writer": "host"
    }
  }
}
