{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywidgetinstruments.github.io/anywidget-instruments-industrial/schema/deviation.schema.json",
  "title": "DeviationIndicator",
  "description": "Centre-zero bar of the deviation between a value and its setpoint (IND-100).",
  "type": "object",
  "x-awi-class": "DeviationIndicator",
  "allOf": [
    {
      "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "deviation",
      "default": "deviation",
      "x-awi-writer": "host"
    },
    "format": {
      "type": "string",
      "description": "printf-like spec of the deviation (NUM-004).",
      "default": "%.2f",
      "x-awi-writer": "host"
    },
    "mode": {
      "default": "indicator"
    },
    "setpoint": {
      "type": "number",
      "description": "Setpoint; the bar shows value - setpoint.",
      "default": 0.0,
      "x-awi-writer": "host"
    },
    "size": {
      "default": [
        220,
        44
      ]
    },
    "span": {
      "type": "number",
      "description": "Half-range of the bar (must be > 0).",
      "default": 10.0,
      "x-awi-writer": "host",
      "exclusiveMinimum": 0
    },
    "tolerance": {
      "type": "number",
      "minimum": 0.0,
      "description": "Half-width of the tolerance band; outside it the bar takes the alarm color and reads HIGH or LOW.",
      "default": 1.0,
      "x-awi-writer": "host"
    },
    "unit": {
      "type": "string",
      "description": "Unit shown with the deviation.",
      "default": "",
      "x-awi-writer": "host"
    },
    "value": {
      "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json#/$defs/float",
      "description": "Measured value.",
      "default": "nan",
      "x-awi-writer": "host"
    }
  }
}
