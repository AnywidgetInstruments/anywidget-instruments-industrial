{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywidgetinstruments.github.io/anywidget-instruments-industrial/schema/intensitychart.schema.json",
  "title": "IntensityChart",
  "description": "Scrolling 2-D color map: spectrogram or waterfall (CHART-101).",
  "type": "object",
  "x-awi-class": "IntensityChart",
  "allOf": [
    {
      "$ref": "graph.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "intensitychart",
      "default": "intensitychart",
      "x-awi-writer": "host"
    },
    "value": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "description": "Rows appended since the last clear."
        },
        "min": {
          "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json#/$defs/float"
        },
        "max": {
          "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json#/$defs/float"
        },
        "argmax": {
          "type": "integer",
          "description": "Bin of the largest value; -1 without a finite value."
        }
      },
      "description": "Summary of the latest row {rows, min, max, argmax}, written by the host with each append.",
      "default": {},
      "readOnly": true,
      "x-awi-writer": "host"
    },
    "history": {
      "type": "integer",
      "minimum": 2,
      "description": "Rows kept and shown.",
      "default": 200,
      "x-awi-writer": "host"
    },
    "n_bins": {
      "type": "integer",
      "minimum": 1,
      "description": "Values per row.",
      "default": 64,
      "x-awi-writer": "host"
    },
    "dt": {
      "type": "number",
      "description": "Time step between rows in x-axis units; 0 is shown as 1.",
      "default": 1.0,
      "x-awi-writer": "host"
    },
    "y_min": {
      "type": "number",
      "description": "Value of the lower edge of the first bin.",
      "default": 0.0,
      "x-awi-writer": "host"
    },
    "y_max": {
      "$ref": "https://anywidgetinstruments.github.io/anywidget-instruments/schema/instrument.schema.json#/$defs/optionalNumber",
      "description": "Value of the upper edge of the last bin; null: y_min + n_bins.",
      "default": null,
      "x-awi-writer": "host"
    },
    "z_min": {
      "type": "number",
      "description": "Color range when autoscale_z is off.",
      "default": 0.0,
      "x-awi-writer": "host"
    },
    "z_max": {
      "type": "number",
      "default": 1.0,
      "x-awi-writer": "host"
    },
    "autoscale_z": {
      "type": "boolean",
      "default": true,
      "x-awi-writer": "host"
    },
    "colormap": {
      "enum": [
        "viridis",
        "inferno",
        "magma",
        "plasma",
        "gray",
        "jet"
      ],
      "default": "viridis",
      "x-awi-writer": "host"
    },
    "show_colorbar": {
      "type": "boolean",
      "default": true,
      "x-awi-writer": "host"
    }
  },
  "x-awi-messages": [
    {
      "type": "append",
      "direction": "host-to-front",
      "description": "New rows. total counts every row appended since the last clear; when more than history rows were appended, only the last history are sent.",
      "fields": {
        "n_rows": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "buffers": [
        {
          "dtype": "<f4",
          "shape": [
            "n_rows",
            "n_bins"
          ],
          "order": "C",
          "description": "Rows, oldest first, one per time step, n_bins values each."
        }
      ]
    },
    {
      "type": "snapshot",
      "direction": "host-to-front",
      "description": "Kept rows (at most history), in reply to sync_request and when history or n_bins changes.",
      "fields": {
        "n_rows": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "buffers": [
        {
          "dtype": "<f4",
          "shape": [
            "n_rows",
            "n_bins"
          ],
          "order": "C",
          "description": "Rows, oldest first, one per time step, n_bins values each."
        }
      ]
    },
    {
      "type": "clear",
      "direction": "host-to-front",
      "description": "Empty the history.",
      "fields": {},
      "buffers": []
    },
    {
      "type": "sync_request",
      "direction": "front-to-host",
      "description": "Sent by each new view: the host answers with a snapshot. A host without history can ignore it.",
      "fields": {},
      "buffers": []
    }
  ]
}
