{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-instruments/schema/gauge.schema.json",
  "title": "Gauge",
  "description": "Circular or semicircular gauge with needle and colored ranges (NUM-103).",
  "type": "object",
  "x-awi-class": "Gauge",
  "allOf": [
    {
      "$ref": "peakhold.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "gauge",
      "default": "gauge",
      "x-awi-writer": "host"
    },
    "mode": {
      "default": "indicator"
    },
    "variant": {
      "enum": [
        "circular",
        "semicircular"
      ],
      "default": "circular",
      "x-awi-writer": "host"
    },
    "ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "{\"from\": number, \"to\": number, \"color\": CSS color}"
      },
      "description": "Colored ranges drawn on the scale; unsafe colors are ignored (SEC-002).",
      "default": [],
      "x-awi-writer": "host"
    }
  }
}
