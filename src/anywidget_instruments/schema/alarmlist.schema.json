{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-instruments/schema/alarmlist.schema.json",
  "title": "AlarmList",
  "description": "Alarm summary table with shelving, suppression and out-of-service states (IND-050 .. IND-053).",
  "type": "object",
  "x-awi-class": "AlarmList",
  "allOf": [
    {
      "$ref": "instrument.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "alarmlist",
      "default": "alarmlist",
      "x-awi-writer": "host"
    },
    "size": {
      "default": [
        640,
        240
      ]
    },
    "value": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "description": "Local ISO time of activation."
          },
          "source": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string"
          },
          "state": {
            "enum": [
              "normal",
              "active_unacknowledged",
              "active_acknowledged",
              "cleared_unacknowledged"
            ]
          },
          "shelved_until": {
            "type": [
              "string",
              "null"
            ],
            "description": "Local ISO time the shelving ends; null: not shelved."
          },
          "suppressed": {
            "type": "boolean"
          },
          "out_of_service": {
            "type": "boolean"
          }
        }
      },
      "description": "Alarms {id, timestamp, source, priority, message, state, shelved_until, suppressed, out_of_service}. Written by the host (Python: raise_alarm(), suppress(), ...); without a host owning the state, the front end applies acknowledgements, shelving and its expiry, and writes the list back (HOST-004, HOST-012).",
      "default": [],
      "readOnly": true,
      "x-awi-writer": "derived"
    },
    "shelve_durations": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Shelving durations offered, in seconds.",
      "default": [
        300,
        900,
        3600
      ],
      "x-awi-writer": "host"
    },
    "max_shelve": {
      "type": "number",
      "minimum": 1,
      "description": "Longest shelving allowed, in seconds (IND-051).",
      "default": 28800,
      "x-awi-writer": "host"
    }
  },
  "x-awi-messages": [
    {
      "type": "ack",
      "direction": "front-to-host",
      "description": "ACK of one alarm.",
      "fields": {
        "alarm_id": {
          "type": "string"
        }
      },
      "buffers": []
    },
    {
      "type": "shelve",
      "direction": "front-to-host",
      "description": "Shelve an alarm.",
      "fields": {
        "alarm_id": {
          "type": "string"
        },
        "seconds": {
          "type": "number"
        }
      },
      "buffers": []
    },
    {
      "type": "unshelve",
      "direction": "front-to-host",
      "description": "Unshelve an alarm.",
      "fields": {
        "alarm_id": {
          "type": "string"
        }
      },
      "buffers": []
    }
  ]
}
