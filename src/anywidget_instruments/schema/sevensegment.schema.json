{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-instruments/schema/sevensegment.schema.json",
  "title": "SevenSegment",
  "description": "Seven-segment numeric display (NUM-109).",
  "type": "object",
  "x-awi-class": "SevenSegment",
  "allOf": [
    {
      "$ref": "numeric.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "sevensegment",
      "default": "sevensegment",
      "x-awi-writer": "host"
    },
    "color": {
      "type": "string",
      "description": "CSS color of the lit segments; empty: the theme color. Unsafe colors are ignored (SEC-002).",
      "default": "",
      "x-awi-writer": "host"
    },
    "decimals": {
      "type": "integer",
      "minimum": 0,
      "description": "Digits after the decimal point.",
      "default": 1,
      "x-awi-writer": "host"
    },
    "digits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "description": "Number of digit positions.",
      "default": 4,
      "x-awi-writer": "host"
    },
    "max": {
      "default": 1000000000.0
    },
    "min": {
      "default": -1000000000.0
    },
    "mode": {
      "default": "indicator"
    },
    "size": {
      "default": [
        200,
        80
      ]
    }
  }
}
