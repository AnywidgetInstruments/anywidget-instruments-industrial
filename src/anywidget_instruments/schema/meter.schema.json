{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-instruments/schema/meter.schema.json",
  "title": "Meter",
  "description": "Analog needle meter with a sector scale (NUM-104).",
  "type": "object",
  "x-awi-class": "Meter",
  "allOf": [
    {
      "$ref": "peakhold.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "meter",
      "default": "meter",
      "x-awi-writer": "host"
    },
    "mode": {
      "default": "indicator"
    },
    "size": {
      "default": [
        200,
        140
      ]
    },
    "angle_range": {
      "type": "number",
      "minimum": 20,
      "maximum": 150,
      "description": "Angle swept by the scale, in degrees.",
      "default": 90,
      "x-awi-writer": "host"
    }
  }
}
