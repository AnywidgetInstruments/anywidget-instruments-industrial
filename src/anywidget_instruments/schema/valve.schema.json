{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-instruments/schema/valve.schema.json",
  "title": "Valve",
  "description": "On/off or control valve (SCADA-001).",
  "type": "object",
  "x-awi-class": "Valve",
  "allOf": [
    {
      "$ref": "process.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "valve",
      "default": "valve",
      "x-awi-writer": "host"
    },
    "commands": {
      "default": [
        "open",
        "close"
      ],
      "x-awi-simulated": {
        "open": "open",
        "close": "closed"
      }
    },
    "value": {
      "enum": [
        "open",
        "closed",
        "transit",
        "fault"
      ],
      "description": "Valve state (feedback from the process).",
      "default": "closed",
      "x-awi-writer": "host"
    },
    "position": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Opening in % for a control valve (feedback); null: on/off valve. A control valve faceplate also takes a position demand in manual mode (with simulate, applied to position and value).",
      "default": null,
      "x-awi-writer": "host"
    },
    "orientation": {
      "enum": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal",
      "x-awi-writer": "host"
    }
  },
  "x-awi-messages": [
    {
      "type": "command",
      "direction": "front-to-host",
      "description": "Position demand of a control valve, 0 to 100 %, manual mode only.",
      "fields": {
        "command": {
          "const": "position"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "buffers": []
    }
  ]
}
