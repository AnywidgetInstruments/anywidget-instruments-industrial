{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-instruments/schema/waveformchart.schema.json",
  "title": "WaveformChart",
  "description": "Scrolling multi-trace chart fed with binary samples (CHART-001 .. CHART-009).",
  "type": "object",
  "x-awi-class": "WaveformChart",
  "allOf": [
    {
      "$ref": "graph.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "waveformchart",
      "default": "waveformchart",
      "x-awi-writer": "host"
    },
    "value": {
      "type": "array",
      "items": {
        "$ref": "instrument.schema.json#/$defs/float"
      },
      "description": "Latest sample of each trace, written by the host with each append.",
      "default": [],
      "readOnly": true,
      "x-awi-writer": "host"
    },
    "history": {
      "type": "integer",
      "minimum": 2,
      "description": "Points kept and shown per trace.",
      "default": 1024,
      "x-awi-writer": "host"
    },
    "n_traces": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "x-awi-writer": "host"
    },
    "update_mode": {
      "enum": [
        "strip",
        "scope",
        "sweep"
      ],
      "description": "strip: continuous scroll; scope: fill then restart; sweep: a moving cursor overwrites the oldest data.",
      "default": "strip",
      "x-awi-writer": "host"
    },
    "y_min": {
      "type": "number",
      "description": "Y range when autoscale_y is off; set by the operator with the axes panel.",
      "default": -1.0,
      "x-awi-writer": "both"
    },
    "y_max": {
      "type": "number",
      "default": 1.0,
      "x-awi-writer": "both"
    },
    "autoscale_y": {
      "type": "boolean",
      "default": false,
      "x-awi-writer": "both"
    },
    "paused": {
      "type": "boolean",
      "description": "Freeze the display; samples keep arriving (CHART-009).",
      "default": false,
      "x-awi-writer": "host"
    },
    "dt": {
      "type": "number",
      "description": "Sample interval in x-axis units; 0 is shown as 1.",
      "default": 1.0,
      "x-awi-writer": "host"
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "visible": {
            "type": "boolean"
          }
        }
      },
      "description": "Optional style of each trace {name, color, width, visible}.",
      "default": [],
      "x-awi-writer": "host"
    },
    "show_legend": {
      "type": "boolean",
      "default": true,
      "x-awi-writer": "host"
    }
  },
  "x-awi-messages": [
    {
      "type": "append",
      "direction": "host-to-front",
      "description": "New samples. total counts every sample appended since the last clear; when more than history points were appended, only the last history are sent and total keeps the count right.",
      "fields": {
        "n_points": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "buffers": [
        {
          "dtype": "<f4",
          "shape": [
            "n_points",
            "n_traces"
          ],
          "order": "C",
          "description": "Samples, oldest first, one row per point and one column per trace."
        }
      ]
    },
    {
      "type": "snapshot",
      "direction": "host-to-front",
      "description": "Whole kept history (at most history points), in reply to sync_request and when history or n_traces changes.",
      "fields": {
        "n_points": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "buffers": [
        {
          "dtype": "<f4",
          "shape": [
            "n_points",
            "n_traces"
          ],
          "order": "C",
          "description": "Samples, oldest first, one row per point and one column per trace."
        }
      ]
    },
    {
      "type": "clear",
      "direction": "host-to-front",
      "description": "Empty the history.",
      "fields": {},
      "buffers": []
    },
    {
      "type": "sync_request",
      "direction": "front-to-host",
      "description": "Sent by each new view: the host answers with a snapshot. A host without history can ignore it.",
      "fields": {},
      "buffers": []
    }
  ]
}
