{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-instruments/schema/numericentry.schema.json",
  "title": "NumericEntry",
  "description": "Numeric keypad with a display, for touch panels (IND-104).",
  "type": "object",
  "x-awi-class": "NumericEntry",
  "allOf": [
    {
      "$ref": "numeric.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "numericentry",
      "default": "numericentry",
      "x-awi-writer": "host"
    },
    "confirm_delta": {
      "$ref": "instrument.schema.json#/$defs/optionalNumber",
      "description": "A change larger than this asks for a second Enter (confirmation); null: no confirmation (IND-104).",
      "default": null,
      "x-awi-writer": "host"
    },
    "format": {
      "default": "%.2f"
    },
    "size": {
      "default": [
        180,
        230
      ]
    }
  }
}
