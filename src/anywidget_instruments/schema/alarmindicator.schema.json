{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-celles.github.io/anywidget-instruments/schema/alarmindicator.schema.json",
  "title": "AlarmIndicator",
  "description": "Single alarm annunciator with the ISA-18.2 alarm states (SCADA-005, SCADA-007).",
  "type": "object",
  "x-awi-class": "AlarmIndicator",
  "allOf": [
    {
      "$ref": "instrument.schema.json"
    }
  ],
  "properties": {
    "_kind": {
      "const": "alarmindicator",
      "default": "alarmindicator",
      "x-awi-writer": "host"
    },
    "alarm_id": {
      "type": "string",
      "description": "Identifier passed to the acknowledgement callbacks.",
      "default": "",
      "x-awi-writer": "host"
    },
    "message": {
      "type": "string",
      "description": "Alarm message (plain text, SEC-002).",
      "default": "",
      "x-awi-writer": "host"
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Priority, shown by a shape and a P1 .. P4 text as well as a color (A11Y-003).",
      "default": "high",
      "x-awi-writer": "host"
    },
    "size": {
      "default": [
        260,
        64
      ]
    },
    "value": {
      "enum": [
        "normal",
        "active_unacknowledged",
        "active_acknowledged",
        "cleared_unacknowledged"
      ],
      "description": "ISA-18.2 alarm state. Transitions (x-awi-transitions, [state, event, next]): activate and clear come from the host; acknowledge from the operator (ACK), applied by the host when it owns the state, otherwise by the front end, which always sends the ack message (HOST-004).",
      "default": "normal",
      "x-awi-writer": "both",
      "x-awi-transitions": [
        [
          "normal",
          "activate",
          "active_unacknowledged"
        ],
        [
          "cleared_unacknowledged",
          "activate",
          "active_unacknowledged"
        ],
        [
          "active_unacknowledged",
          "clear",
          "cleared_unacknowledged"
        ],
        [
          "active_acknowledged",
          "clear",
          "normal"
        ],
        [
          "active_unacknowledged",
          "acknowledge",
          "active_acknowledged"
        ],
        [
          "cleared_unacknowledged",
          "acknowledge",
          "normal"
        ]
      ]
    }
  },
  "x-awi-messages": [
    {
      "type": "ack",
      "direction": "front-to-host",
      "description": "The operator pressed ACK (control mode, not disabled).",
      "fields": {},
      "buffers": []
    }
  ]
}
