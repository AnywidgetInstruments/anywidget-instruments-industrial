{
  "description": "Machine state model (IND-060 .. IND-063): models as the kernel stores them, and operator command sequences. Each step is [command, expected state, expected available commands]; a command that is not valid keeps the state. \"SC\" completes an acting state (a host event). A model given by name is a preset of the schema (x-awi-presets): gemma (IND-064), isa88 (IND-065).",
  "normalize": [
    { "model": { "states": [{ "name": "Off" }, { "name": "On", "acting": true }], "transitions": [["Off", "Start", "On"], ["On", "Stop", "Off"]] },
      "expected": { "states": [{ "name": "Off", "x": 0, "y": 0, "acting": false }, { "name": "On", "x": 1, "y": 0, "acting": true }], "transitions": [["Off", "Start", "On"], ["On", "Stop", "Off"]], "commands": ["Start", "Stop"], "initial": "Off" } },
    { "model": { "states": [{ "name": "A" }, { "name": "B" }, { "name": "C" }, { "name": "D" }, { "name": "E" }, { "name": "F" }], "transitions": [["A", "SC", "B"]], "commands": ["Go"], "initial": "F" },
      "expected": { "states": [{ "name": "A", "x": 0, "y": 0, "acting": false }, { "name": "B", "x": 1, "y": 0, "acting": false }, { "name": "C", "x": 2, "y": 0, "acting": false }, { "name": "D", "x": 3, "y": 0, "acting": false }, { "name": "E", "x": 4, "y": 0, "acting": false }, { "name": "F", "x": 0, "y": 1, "acting": false }], "transitions": [["A", "SC", "B"]], "commands": ["Go"], "initial": "F" } },
    { "model": {"states": [{"name": "A1", "title": "Initial stop", "group": "A"}, {"name": "F1", "group": "F"}], "transitions": [["A1", "Start", "F1"], ["F1", "E-stop", "A1"]], "global_commands": ["E-stop"]},
      "expected": {"states": [{"name": "A1", "title": "Initial stop", "group": "A", "x": 0, "y": 0, "acting": false}, {"name": "F1", "group": "F", "x": 1, "y": 0, "acting": false}], "transitions": [["A1", "Start", "F1"], ["F1", "E-stop", "A1"]], "global_commands": ["E-stop"], "commands": ["Start", "E-stop"], "initial": "A1"} }
  ],
  "invalid": [
    { "states": [] },
    { "states": [{ "name": "A" }, { "name": "A" }] },
    { "states": [{ "name": "A" }], "transitions": [["A", "Go", "Z"]] },
    { "states": [{ "name": "A" }], "initial": "Z" },
    {"states": [{"name": "A"}], "transitions": [["A", "Go", "A"]], "global_commands": ["Stop"]},
    {"states": [{"name": "A", "title": 3}]}
  ],
  "sequences": [
    { "name": "PackML start-up", "model": null, "steps": [
      ["Start", "Stopped", ["Reset", "Abort"]],
      ["Reset", "Resetting", ["Stop", "Abort"]],
      ["SC", "Idle", ["Start", "Stop", "Abort"]],
      ["Start", "Starting", ["Stop", "Abort"]],
      ["SC", "Execute", ["Stop", "Hold", "Suspend", "Abort"]],
      ["Hold", "Holding", ["Stop", "Abort"]],
      ["Abort", "Aborting", []] ] },
    { "name": "custom model", "model": { "states": [{ "name": "Off" }, { "name": "On" }], "transitions": [["Off", "Start", "On"], ["On", "Stop", "Off"]] }, "steps": [
      ["Stop", "Off", ["Start"]],
      ["Start", "On", ["Stop"]],
      ["Stop", "Off", ["Start"]] ] },
    { "name": "GEMMA preparation, stop in a given state, failure, emergency stop", "model": "gemma", "steps": [
      ["Prepare", "F2", ["Fault", "E-stop"]],
      ["SC", "F1", ["End of cycle", "Stop", "Close", "Fault", "E-stop"]],
      ["Stop", "A3", ["E-stop"]],
      ["SC", "A4", ["Start", "E-stop"]],
      ["Start", "F1", ["End of cycle", "Stop", "Close", "Fault", "E-stop"]],
      ["Fault", "D2", ["Degraded run", "Repaired", "E-stop"]],
      ["Degraded run", "D3", ["End of cycle", "E-stop"]],
      ["End of cycle", "A2", ["E-stop"]],
      ["SC", "A1", ["Start", "Prepare", "Check", "Step check", "Test", "E-stop"]],
      ["E-stop", "D1", ["Rearm"]],
      ["Start", "D1", ["Rearm"]],
      ["Rearm", "A5", ["E-stop", "To initial state", "To given state"]],
      ["To initial state", "A6", ["E-stop"]],
      ["SC", "A1", ["Start", "Prepare", "Check", "Step check", "Test", "E-stop"]]
    ] },
    { "name": "ISA-88 procedural states", "model": "isa88", "steps": [
      ["Start", "Running", ["Pause", "Hold", "Stop", "Abort"]],
      ["Pause", "Pausing", ["Hold", "Stop", "Abort"]],
      ["SC", "Paused", ["Resume", "Hold", "Stop", "Abort"]],
      ["Resume", "Running", ["Pause", "Hold", "Stop", "Abort"]],
      ["Hold", "Holding", ["Stop", "Abort"]],
      ["SC", "Held", ["Restart", "Stop", "Abort"]],
      ["Restart", "Restarting", ["Stop", "Abort"]],
      ["SC", "Running", ["Pause", "Hold", "Stop", "Abort"]],
      ["Stop", "Stopping", ["Abort"]],
      ["SC", "Stopped", ["Reset"]],
      ["Reset", "Idle", ["Start"]],
      ["Start", "Running", ["Pause", "Hold", "Stop", "Abort"]],
      ["SC", "Complete", ["Reset"]],
      ["Reset", "Idle", ["Start"]]
    ] }
  ]
}
